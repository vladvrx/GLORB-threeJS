@echo off
set "GLORB_LOCAL_FOLDER=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$Port=43219; $NoBrowser=($env:GLORB_NO_BROWSER -eq '1'); $ErrorActionPreference = 'Stop' ; $gameFolder = [IO.Path]::GetFullPath($env:GLORB_LOCAL_FOLDER).TrimEnd([IO.Path]::DirectorySeparatorChar) ; foreach ($required in @('index.html', 'vendor\three\three.module.js', 'assets\fonts\Outfit.ttf')) { if (-not (Test-Path -LiteralPath (Join-Path $gameFolder $required))) { throw 'Extract the entire GLORB ZIP into a folder, then run Start GLORB.cmd from that folder.' ; } ; } ; $listener = $null ; for ($attempt = 0; $attempt -lt 100; $attempt++) { $candidate = New-Object System.Net.HttpListener ; $gameUrl = 'http://127.0.0.1:' + ($Port + $attempt) + '/' ; $candidate.Prefixes.Add($gameUrl) ; try { $candidate.Start() ; $listener = $candidate ; break ; } catch { $candidate.Close() ; } ; } ; if (-not $listener) { throw 'Could not start a local server. No available port in the GLORB launcher range.' ; } ; try { Write-Host ('GLORB is running at ' + $gameUrl) ; Write-Host 'Keep this window open while playing. Close it to stop the game server.' ; if (-not $NoBrowser) { Start-Process $gameUrl } ; $types = @{ '.html' = 'text/html; charset=utf-8'; '.js' = 'text/javascript; charset=utf-8' ; '.css' = 'text/css; charset=utf-8'; '.json' = 'application/json; charset=utf-8' ; '.wasm' = 'application/wasm'; '.glb' = 'model/gltf-binary' ; '.png' = 'image/png'; '.jpg' = 'image/jpeg'; '.jpeg' = 'image/jpeg' ; '.webp' = 'image/webp'; '.avif' = 'image/avif'; '.svg' = 'image/svg+xml' ; '.wav' = 'audio/wav'; '.m4a' = 'audio/mp4'; '.mp3' = 'audio/mpeg' ; '.ogg' = 'audio/ogg'; '.woff' = 'font/woff'; '.woff2' = 'font/woff2'; '.ttf' = 'font/ttf' ; '.ico' = 'image/x-icon'; '.bin' = 'application/octet-stream' ; } ; while ($listener.IsListening) { $context = $listener.GetContext() ; $response = $context.Response ; try { if ($context.Request.HttpMethod -notin @('GET', 'HEAD')) { $response.StatusCode = 405 ; continue ; } ; $relative = [Uri]::UnescapeDataString($context.Request.Url.AbsolutePath).TrimStart('/') ; if (-not $relative) { $relative = 'index.html' } ; $file = [IO.Path]::GetFullPath((Join-Path $gameFolder $relative)) ; if (-not $file.StartsWith($gameFolder + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) { $response.StatusCode = 403 ; continue ; } ; if (-not [IO.File]::Exists($file)) { $response.StatusCode = 404 ; continue ; } ; $response.ContentType = $types[[IO.Path]::GetExtension($file).ToLowerInvariant()] ; if (-not $response.ContentType) { $response.ContentType = 'application/octet-stream' } ; $response.Headers['Cache-Control'] = 'no-store' ; $bytes = [IO.File]::ReadAllBytes($file) ; $response.ContentLength64 = $bytes.Length ; if ($context.Request.HttpMethod -eq 'GET') { $response.OutputStream.Write($bytes, 0, $bytes.Length) ; } ; } catch { Write-Warning $_.Exception.Message ; } finally { $response.Close() ; } ; } ; } finally { $listener.Close() ; } ;"
if errorlevel 1 pause
